ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://cortai_app:cortai_app@localhost:5432/cortai
JWT_ISSUER=cortai-api
JWT_AUDIENCE=cortai-platform
JWT_TTL_SECONDS=43200
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
# Must include the frontend origin(s) for WebSocket handshake (Origin check).
# Examples:
# - CORS_ORIGINS=["http://localhost:3000","http://15.223.47.64"]
# - CORS_ORIGINS=["https://app.cortai-staging.lionston.com"]
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_DOMAIN=

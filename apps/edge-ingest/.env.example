ENVIRONMENT=local
DATABASE_URL=postgresql://cortai_app:cortai_app@localhost:5432/cortai

# MQTT
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TOPIC=cortai/+/+/edge/+/+

# TLS/mTLS (paths on the host running edge-ingest)
# NOTE: edge-ingest runs as user `cortai`; keep these readable by that user.
MQTT_CA_FILE=/opt/cortai/secrets/edge-ingest-tls/ca.crt
MQTT_CLIENT_CERT=/opt/cortai/secrets/edge-ingest-tls/edge-0007.crt
MQTT_CLIENT_KEY=/opt/cortai/secrets/edge-ingest-tls/edge-0007.key


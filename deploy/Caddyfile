{
  # NOTE:
  # - Domain sites below rely on public DNS so Caddy can provision HTTPS.
  # - Raw IP access is handled by the explicit `:80` site at the bottom.
}

# Optional domains (only work once DNS exists)
api.cortai-staging.lionston.com {
  reverse_proxy 127.0.0.1:8000
}

app.cortai-staging.lionston.com {
  @api path /api/* /docs* /openapi.json
  reverse_proxy @api 127.0.0.1:8000

  @ws path /ws/*
  reverse_proxy @ws 127.0.0.1:8000

  reverse_proxy 127.0.0.1:3000
}

# Raw IP access (HTTP)
:80 {
  # Serve Next static assets directly (no proxy -> no %5B/%5D decoding issues)
  handle_path /_next/static/* {
    root * /opt/cortai/apps/cortai-frontend/.next/static
    file_server
  }

  @api path /api/* /docs* /openapi.json
  reverse_proxy @api 127.0.0.1:8000

  @ws path /ws/*
  reverse_proxy @ws 127.0.0.1:8000

  reverse_proxy 127.0.0.1:3000
}

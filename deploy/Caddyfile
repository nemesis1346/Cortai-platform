{
  # Production TLS via Let's Encrypt requires ports 80/443 open
  # and DNS records for the hostnames below pointing to this server.
}

api.cortai-staging.lionston.com {
  reverse_proxy 127.0.0.1:8000
}

app.cortai-staging.lionston.com {
  reverse_proxy 127.0.0.1:3000
}

# Redirect raw-IP HTTP access to the HTTPS app domain (prevents clear-text JWT/cookies).
:80 {
  redir https://app.cortai-staging.lionston.com{uri} permanent
}

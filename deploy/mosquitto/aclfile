# Mosquitto ACL file
#
# We use mTLS and map the client cert identity to username:
#   use_identity_as_username true
#
# Convention for this V1 broker:
# - Client cert CN (or SAN mapped by Mosquitto) should be: device_id
# - Device is allowed to publish and subscribe only to its own device_id path.
#
# Topics: cortai/{org}/{property}/edge/{device_id}/{type}
# Types: detection | telemetry | health | event
#
# NOTE: Mosquitto ACL variable substitution works with `pattern` rules.
#   %u = username (mapped from client cert identity via use_identity_as_username)

# Ingest service (privileged): can read all device topics.
user edge-ingest
topic read cortai/+/+/edge/+/+

# Default rule for device clients: only their own device_id path.
pattern readwrite cortai/+/+/edge/%u/+


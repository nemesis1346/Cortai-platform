[Unit]
Description=COrtai Next.js frontend
After=network-online.target cortai-api.service
Wants=network-online.target

[Service]
User=cortai
Group=cortai
WorkingDirectory=/opt/cortai/apps/cortai-frontend
Environment=NODE_ENV=production
EnvironmentFile=/opt/cortai/apps/cortai-frontend/.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
